# Team Notes Service GraphQL Schema
# Good API practices: clear types, input objects for mutations, pagination hints, nullable where appropriate.

type Query {
    """Get a single note by ID (if caller has access)"""
    note(id: ID!): Note

    """List notes for the current user (personal + team notes they can access)"""
    myNotes(teamId: ID, limit: Int = 20, offset: Int = 0): [Note!]!

    """Search notes by title or content (scoped to accessible notes)"""
    searchNotes(query: String!, teamId: ID, limit: Int = 20): [Note!]!

    """Teams the current user belongs to"""
    myTeams: [Team!]!

    """Members of a specific team (requires membership)"""
    teamMembers(teamId: ID!): [TeamMember!]!
}

type Mutation {
    """Create a new note. If teamId is provided, the note is shared with the team."""
    createNote(input: CreateNoteInput!): Note!

    """Update an existing note. Only owner or team members with access may update."""
    updateNote(id: ID!, input: UpdateNoteInput!): Note!

    """Delete a note. Only the owner (or team admin) may delete."""
    deleteNote(id: ID!): Boolean!

    """Create a new team. Creator becomes owner."""
    createTeam(name: String!): Team!

    """Add a user to a team (owner/admin only)."""
    addMemberToTeam(teamId: ID!, userId: ID!, role: Role = MEMBER): TeamMember!

    """Remove a member from a team."""
    removeMemberFromTeam(teamId: ID!, userId: ID!): Boolean!
}

# Core Types

type Note {
    id: ID!
    title: String!
    content: String!
    ownerId: ID!
    ownerName: String!
    teamId: ID
    createdAt: String!
    updatedAt: String!
    """Whether the current user can edit or delete this note (note owner or team ADMIN/OWNER)"""
    canModify: Boolean!
}

type Team {
    id: ID!
    name: String!
    createdBy: ID!
    createdAt: String!
}

type TeamMember {
    teamId: ID!
    userId: ID!
    role: Role!
    joinedAt: String!
}

enum Role {
    OWNER
    ADMIN
    MEMBER
}

# Input types (good practice: explicit inputs for mutations)

input CreateNoteInput {
    title: String!
    content: String!
    """Optional: share immediately with a team"""
    teamId: ID
}

input UpdateNoteInput {
    title: String
    content: String
}

# Future improvement area (documented in README):
# - Proper Connection types for cursor pagination
# - Rich content (blocks / JSON)
# - Comments on notes
# - Version history
