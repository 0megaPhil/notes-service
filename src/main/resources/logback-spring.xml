<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- Use Spring Boot's default console appender and pattern -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN:-%clr(%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd HH:mm:ss.SSS}}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- Application specific loggers -->
    <logger name="com.notetaking.notes" level="INFO"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.security" level="INFO"/>

    <!-- Reactive / R2DBC logging (useful during development) -->
    <logger name="org.springframework.r2dbc" level="INFO"/>
    <logger name="io.r2dbc" level="WARN"/>

    <!-- For development, you can raise the level of your package -->
    <!-- <springProfile name="dev">
        <logger name="com.notetaking.notes" level="DEBUG"/>
    </springProfile> -->

</configuration>
